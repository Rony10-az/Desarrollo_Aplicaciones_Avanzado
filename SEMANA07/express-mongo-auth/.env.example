# Servidor
PORT=3000

# Conexión a MongoDB (local o Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/express-mongo-auth

# JSON Web Token
JWT_SECRET=cambia_esto_por_una_clave_larga_y_aleatoria
JWT_EXPIRES_IN=1h

# Costo del hash de contraseñas (bcrypt)
BCRYPT_SALT_ROUNDS=10

# Administrador inicial (se crea al arrancar si no existe)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CambiaEsta123@
ADMIN_NAME=Admin
ADMIN_LAST_NAME=User
ADMIN_PHONE=000000000
ADMIN_BIRTHDATE=1990-01-01
ADMIN_PROFILE_URL=
ADMIN_ADDRESS=
